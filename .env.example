PORT=8080
BRIEF_DATA_DIR=/data
BRIEF_PUBLIC_ORIGIN=
TUMA_EMAIL=
TUMA_API_KEY=
TUMA_WEBHOOK_SECRET=
HANDOFF_SECRET=
# Signs the one-tap email links used when someone arrives from a shared link.
# Optional: the server generates and persists one if this is empty.
BRIEF_LINK_SECRET=
# Google Sign-In. Without it /api/auth/google returns 503 with a stated reason
# rather than faking a session. The client build needs the SAME id as
# VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
