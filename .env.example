# ---------------------------------------------------------------------------
# BRIEF — deployment environment. Copy to .env (never commit it).
#
# The honest rule: a seam with no credential FAILS CLOSED and says why
# (/api/capabilities reports every connector's true state). Set only what
# your deployment actually uses; everything else stays honestly off.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Listen port (hostings often set this themselves).
PORT=8787
NODE_ENV=production
# Where the JSON store lives. Point this at a PERSISTENT VOLUME in production
# — on an ephemeral filesystem everything here is wiped on every redeploy.
BRIEF_DATA_DIR=
# Canonical public origin (share links, connector callbacks). Leave empty and
# the app says "no public link configured" instead of inventing a URL.
BRIEF_PUBLIC_ORIGIN=
BRIEF_PUBLIC_BASE=

# --- People & roles (bootstrap; comma-separated handles) ---------------------
# The deployment's operators/reviewers/finance/admins, granted at boot so a
# fresh deploy can be run without hand-editing a data file. Capabilities are
# additive; routes ask for capabilities, never role names.
# The MEMBERS DESK (directory, suspension) needs an admin named here.
BRIEF_OPERATORS=
BRIEF_REVIEWERS=
BRIEF_FINANCE=
BRIEF_ADMINS=

# --- Brief's own money (Pochi la Biashara, manual-first) ---------------------
# The Pochi number members pay service fees to. Empty = the fee surface says
# so instead of inventing a number. An operator confirms each M-Pesa code.
BRIEF_POCHI_NUMBER=
# Arena real-money stakes stay OFF unless a licence id is configured here
# (the compliance gate refuses with a machine-readable reason otherwise).
BRIEF_GAMING_LICENCE_ID=

# --- Auth --------------------------------------------------------------------
# Google Sign-In (server side). The client build needs the SAME id as
# VITE_GOOGLE_CLIENT_ID. Empty = /api/auth/google returns 503 with a reason.
GOOGLE_CLIENT_ID=
# Signs one-tap email links; the server generates + persists one if empty.
BRIEF_LINK_SECRET=
# NEVER set in production: allows anonymous requests (dev builds only).
BRIEF_DEV_AUTH=

# --- Ingestion connectors (each fails closed until set) ----------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Payments collection (server-side only; none = payments honestly off) ----
TUMA_EMAIL=
TUMA_API_KEY=
TUMA_WEBHOOK_SECRET=

# --- HudumaLink (WhatsApp results desk; AES key encrypts eCitizen tokens) ----
HUDUMA_MASTER_KEY=
HUDUMA_WA_NUMBER=
BRIEF_KYC_PROVIDER=
BRIEF_COLLECTION_PROVIDER=

# --- Sports data (EPL fantasy) -----------------------------------------------
FOOTBALL_PROVIDER=
FOOTBALL_DATA_TOKEN=
APIFOOTBALL_KEY=

# --- Uploads / intervals / secrets -------------------------------------------
# Uploads are files on this machine's disk — point at the volume too.
BRIEF_UPLOAD_DIR=
BRIEF_UPLOAD_MAX_BYTES=
BRIEF_BACKUP_INTERVAL_MS=
BRIEF_WORKFLOW_INTERVAL_MS=
BRIEF_CALENDAR_INTERVAL_MS=
HANDOFF_SECRET=
# Diagnostic logging toggles. Leave off in production.
BRIEF_LOG_READS=
BRIEF_LOG_IN_TEST=
# Feature kill-switch, comma-separated ids.
BRIEF_DISABLED_FEATURES=

# --- Client build only (Vite exposes these to the browser; never secrets) ----
VITE_GOOGLE_CLIENT_ID=
