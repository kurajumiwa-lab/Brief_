{
  "name": "brief",
  "version": "1.0.0",
  "description": "Brief: An information layer for what is happening around you",
  "private": true,
  "type": "module",
  "workspaces": [
    "preview",
    "server",
    "tc"
  ],
  "scripts": {
    "install:all": "npm install && npm --workspace=preview install && npm --workspace=server install && npm --workspace=tc install",
    "build:client": "npm --workspace=preview run build",
    "build": "npm run build:client",
    "start": "NODE_ENV=production node server/src/index.js",
    "start:dev": "cd server && npm start",
    "dev": "cd preview && npm run dev",
    "test": "cd server && npm test",
    "test:notifications": "node server/test/notifications.mjs",
    "test:yard": "npm --workspace=server run test:yard",
    "test:client": "./run-suites.sh",
    "test:typecheck": "node ./node_modules/typescript/bin/tsc -p tc/tsconfig.json",
    "demo:vault": "node scripts/demo-vault.mjs",
    "seed": "node scripts/seed-demo.mjs",
    "seed:clear": "node scripts/seed-demo.mjs --clear",
    "smoke:seeded": "node scripts/smoke-seeded.mjs"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "information",
    "discovery",
    "events",
    "communities"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "lucide-react": "^1.40.0",
    "typescript": "^7.0.2"
  }
}
