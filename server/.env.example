# Brief ingestion server -- copy to .env and fill in.
# NEVER commit the real .env. Every value here is a secret that must stay
# server-side; none of it is ever sent to the browser.

# Port the ingestion API listens on.
PORT=8787

# --- Telegram ---------------------------------------------------------------
# From @BotFather. Without this, Telegram routes return 503 "not configured"
# and the connector dashboard shows "Needs authorization".
TELEGRAM_BOT_TOKEN=

# Shared secret Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token
# header. Generate one: openssl rand -hex 24
# If unset, the server generates a random one at webhook-config time.
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp Cloud API -----------------------------------------------------
# Meta App Dashboard > App Settings > Basic > App Secret.
# Used to verify X-Hub-Signature-256 on every webhook.
WHATSAPP_APP_SECRET=

# A string you invent, entered in Meta's webhook setup form. Meta sends it back
# during the subscription handshake so you can prove the endpoint is yours.
WHATSAPP_VERIFY_TOKEN=

# --- Public origin ----------------------------------------------------------
# The canonical, externally reachable origin for shareable campaign links,
# e.g. https://brief.example.com  (no trailing slash).
#
# UNSET IS A SUPPORTED STATE. When this is empty the API reports
# publicOrigin: null and the app tells the creator no public link is
# configured yet, rather than inventing a URL from whatever host the browser
# happens to be on. Never point this at localhost or a preview host.
BRIEF_PUBLIC_ORIGIN=

# --- Outbound messaging (send) ----------------------------------------------
# Brief can ingest from every channel but could previously send on none. The
# outbound seam (src/outbound.js) routes sends through registered providers.
# Twilio is the first: SMS and WhatsApp-send. Until these are set, send()
# fails closed and /api/capabilities reports outbound.{channel}.configured=false.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender for SMS, e.g. +2547XXXXXXXX  (or set a Messaging Service SID below)
TWILIO_SMS_FROM=
# Optional: a Messaging Service SID replaces TWILIO_SMS_FROM for SMS.
# TWILIO_MESSAGING_SERVICE_SID=
# WhatsApp sender, e.g. whatsapp:+2547XXXXXXXX (WhatsApp Business API)
TWILIO_WHATSAPP_FROM=

# --- Tuma payments (collection) ---------------------------------------------
# Brief's payment gateway. Tuma initiates the M-PESA STK Push and settles the
# collected funds to the business/till configured on the Tuma merchant profile
# (here: the LOOP BIZ / LOOP business account). Brief NEVER holds or needs the
# LOOP number -- that merchant relationship lives entirely on the Tuma side.
#
# Get these from the Tuma merchant portal (https://merchant.tuma.co.ke) under
# Developer -> your business -> Generate API Key:
TUMA_EMAIL=
TUMA_API_KEY=

# A secret you invent, embedded in the webhook path so only Tuma's callback
# (posted to <BRIEF_PUBLIC_ORIGIN>/api/webhooks/tuma/<secret>) is accepted.
# Generate one: openssl rand -hex 24. Fail-closed if unset.
TUMA_WEBHOOK_SECRET=

# Override the API host. Defaults to https://api.tuma.co.ke. Tuma publishes
# no separate sandbox host; leave this unset for production.
# TUMA_BASE_URL=https://api.tuma.co.ke

# The callback URL is built from BRIEF_PUBLIC_ORIGIN (above) + the secret, so
# payments only work once a real public origin is configured.

# --- Storage ----------------------------------------------------------------
# Where the JSON document store lives. Defaults to ./data
# BRIEF_DATA_DIR=/var/lib/brief

# --- Persistence -------------------------------------------------------------
# Where the JSON document store lives. On Railway, point this at a mounted
# persistent volume (e.g. /data) so records survive redeploys — the default
# ./data is on the ephemeral container filesystem and resets on every deploy.
# BRIEF_DATA_DIR=/data

# How often to snapshot the store (milliseconds). Default 900000 (15 min).
# Snapshot files are pruned to the newest 14. Off in tests.
# BRIEF_BACKUP_INTERVAL_MS=900000

# --- Feature registry --------------------------------------------------------
# Comma-separated feature keys to disable at deploy time (see src/features.js).
# A disabled feature 503s at the edge and is reported in /api/capabilities.
# Example: disable Arena and Fantasy without a code change:
# BRIEF_DISABLED_FEATURES=arena,fantasy

# --- HudumaLink (WhatsApp + M-Pesa distributed action layer) -----------------
# A conversational micro-platform that sells completed government/legal
# results inside a WhatsApp thread, paid through M-Pesa escrow. Configure the
# seams you want live; each one fails CLOSED (an honest 503) while unset, so
# the product never fakes a send or a charge.

# The product's WhatsApp business number, used to build "Zero-Click" deep links
# from ads/QR codes: https://wa.me/<HUDUMA_WA_NUMBER>?text=...
HUDUMA_WA_NUMBER=

# AES-256-GCM master key for eCitizen tokens (and any other stored credential).
# Generate one: openssl rand -hex 32   (paste the 64 hex chars)
# Without this, storing an eCitizen token is REFUSED rather than persisted
# in cleartext -- see server/src/domain/huduma/crypto.js.
HUDUMA_MASTER_KEY=

# WhatsApp Cloud API OUTBOUND (interactive menus + document delivery).
# WHATSAPP_TOKEN is a permanent system-user access token; WHATSAPP_PHONE_NUMBER_ID
# is the business number's Graph API id. (Inbound webhook verification uses
# WHATSAPP_APP_SECRET / WHATSAPP_VERIFY_TOKEN above.)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Safaricom M-Pesa Daraja (the escrow STK rail). From your Daraja app at
# https://developer.safaricom.co.ke. Sandbox shortcode is 174379.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
# A secret you invent, embedded in the callback path
# (<BRIEF_PUBLIC_ORIGIN>/api/huduma/webhooks/mpesa/<secret>). Daraja signs
# nothing, so authenticity is this secret PLUS amount/reference re-verification.
# Generate one: openssl rand -hex 24
MPESA_CALLBACK_SECRET=

# --- Engine (sync core + universal router + tier guardrails) -----------------
# HMAC-SHA256 secret used to sign every webhook payload the Universal Data
# Router dispatches (receivers verify the x-brief-signature header against the
# exact bytes). Generate one: openssl rand -hex 24. Fail-closed if unset:
# webhook dispatches are REFUSED rather than sent unsigned.
ENGINE_ROUTER_SECRET=
