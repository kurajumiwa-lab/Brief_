# Brief ingestion server -- copy to .env and fill in.
# NEVER commit the real .env. Every value here is a secret that must stay
# server-side; none of it is ever sent to the browser.

# Port the ingestion API listens on.
PORT=8787

# --- Telegram ---------------------------------------------------------------
# From @BotFather. Without this, Telegram routes return 503 "not configured"
# and the connector dashboard shows "Needs authorization".
TELEGRAM_BOT_TOKEN=

# Shared secret Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token
# header. Generate one: openssl rand -hex 24
# If unset, the server generates a random one at webhook-config time.
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp Cloud API -----------------------------------------------------
# Meta App Dashboard > App Settings > Basic > App Secret.
# Used to verify X-Hub-Signature-256 on every webhook.
WHATSAPP_APP_SECRET=

# A string you invent, entered in Meta's webhook setup form. Meta sends it back
# during the subscription handshake so you can prove the endpoint is yours.
WHATSAPP_VERIFY_TOKEN=

# --- Storage ----------------------------------------------------------------
# Where the JSON document store lives. Defaults to ./data
# BRIEF_DATA_DIR=/var/lib/brief
